# Real values are set per-environment in Vercel (Preview vs Production scopes) — NOT committed.
# This file documents the variables the app expects.

# NextAuth
NEXTAUTH_URL=https://app-lime-orcin.vercel.app   # set to preview URL for Preview env
NEXTAUTH_SECRET=                                  # openssl rand -base64 32

# Google OAuth  (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase  (supabase.com → project → Settings → API)
# Both are server-only: all DB access goes through /api routes, so no NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                        # never expose to the browser
